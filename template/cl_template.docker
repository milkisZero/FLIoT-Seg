  client{NUM}:
    build:
      context: ./Client
      dockerfile: Dockerfile
    env_file:
      - .env
    environment:
      - PYTHONUNBUFFERED=1
    container_name: federated_client{NUM}
    networks:
      federated_network:
        ipv4_address: {IP}
    volumes:
      - ./Client/SYNTHIA_Splitted/client{NUM}/train:/app/SYNTHIA_Splitted/client/train
      - ./Client/SYNTHIA_Splitted/client{NUM}/test:/app/SYNTHIA_Splitted/client/test
      - ./Client/datasetCICIDS.py:/app/datasetCICIDS.py
      - ./Client/fl_client.py:/app/fl_client.py
      - ./results/Client{NUM}:/app/results
    ports:
      - {PORT}:4000
    depends_on:
      server:
        condition: service_healthy
